generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// Domain models will be added in Module 01 (Auth / Organization).
// This placeholder verifies Prisma can connect and migrate.
model HealthCheck {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
}

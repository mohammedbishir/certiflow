# Database (Docker Compose)
DATABASE_URL="postgresql://certiflow:certiflow@127.0.0.1:54329/certiflow?schema=public"

# API
PORT=3001
# Comma-separated: localhost + your PC LAN IP (for phone QR scanning)
CORS_ORIGIN=http://localhost:3000,http://YOUR_LAN_IP:3000

# Auth (change these in production)
JWT_ACCESS_SECRET="certiflow-dev-access-secret-change-me"
JWT_REFRESH_SECRET="certiflow-dev-refresh-secret-change-me"
JWT_ACCESS_EXPIRES_IN="24h"
JWT_REFRESH_EXPIRES_IN="7d"

# QR verify links — use your PC LAN IP (not localhost) so phones can open them
WEB_URL=http://YOUR_LAN_IP:3000

# Web app API base — same LAN IP so phone can call the API
NEXT_PUBLIC_API_URL=http://YOUR_LAN_IP:3001
